<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.hell-play_tmdb"
       name="Hell Play"
       version="1.0.1"
       provider-name="Alistar">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
        <import addon="script.module.requests" version="2.22.0" />
        <import addon="script.module.beautifulsoup4" version="4.12.2"/>
        <import addon="script.module.routing" version="0.2.3" />
        <import addon="script.module.inputstreamhelper" version="0.3.3" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="plugin.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">TV Nova</summary>
        <summary lang="cs_CZ">TV Nova</summary>
        <description lang="en_GB">Doplněk, který streamuje filmy a seriály z Hellspy.to a pro databázi jde připojit k TMDb Helperu</description>
        <description lang="cs_CZ">Doplněk, který streamuje filmy a seriály z Hellspy.to a pro databázi jde připojit k TMDb Helperu</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>